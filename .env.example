# --- Brokerage (Alpaca) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true          # keep true until you're ready for real money

# --- Brokerage switch ---
BROKER=sim   # sim = built-in pretend money (default) | alpaca | ibkr
IBKR_PAPER=true
IBKR_PORT=                 # blank = 4002 paper / 4001 live
IBKR_CLIENT_ID=7

# --- Brain (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Politician trade data (need ONE of these) ---
QUIVER_API_KEY=            # quiverquant.com (paid, best data)
FMP_API_KEY=               # financialmodelingprep.com (free tier works)

# --- Safety ---
DRY_RUN=true               # true = decide + log, never place orders
